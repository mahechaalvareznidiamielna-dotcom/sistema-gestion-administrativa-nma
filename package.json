{
  "name": "sistema-gestion-administrativa-nma",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión administrativa para papelería - Proyecto unificado NestJS full-stack compatible con Vercel",
  "scripts": {
    "build:client": "vite build client",
    "build:server": "nest build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "start:api": "nest start --watch",
    "start:client": "vite client --port 5173",
    "start:dev": "concurrently --kill-others-on-fail -n API,WEB -c cyan,magenta \"npm run start:api\" \"npm run start:client\"",
    "dev": "npm run start:dev"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.21.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.12.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
